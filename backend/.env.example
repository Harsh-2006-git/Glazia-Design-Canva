# ─── Backend Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in the values.

# Server port
PORT=5001

# MongoDB connection string
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/glazia_design_canvas
# Production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/glazia_design_canvas?retryWrites=true&w=majority

# Frontend origin allowed for CORS
# Local:
CLIENT_URL=http://localhost:3000
# Production (Vercel):
# CLIENT_URL=https://glazia-design-canva.vercel.app

# JWT signing secret — use a long random string in production
JWT_SECRET=glazia_design_canvas_jwt_secret_token_change_in_production

# Environment
NODE_ENV=development
# NODE_ENV=production
